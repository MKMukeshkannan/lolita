BasedOnStyle: LLVM
Language: Cpp

IndentWidth: 4
ColumnLimit: 100

BreakBeforeBraces: Custom
BraceWrapping:
  AfterNamespace: false   # namespace foo {
  AfterClass: true        # class Foo\n{
  AfterStruct: true       # struct Bar\n{
  AfterUnion: true
  AfterEnum: true
  AfterFunction: false
  AfterControlStatement: false


